# Public site URL (used for Stripe redirects, sitemap, canonical URLs)
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Database — Postgres connection string (Vercel Postgres / Neon / Supabase).
# Leave unset locally to use the embedded PGlite database in data/runtime/pglite.
DATABASE_URL=

# Stripe (test keys from https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Signing secret of the webhook endpoint pointing at /api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=

# Shared key the factory sends as the x-production-key header to /api/production/*
PRODUCTION_API_KEY=
